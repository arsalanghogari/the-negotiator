
# Optional: live business discovery on the calls page (Places API (New), billing enabled).
# Without it, the baked directory snapshot in config/<vertical>.ts is used.
GOOGLE_PLACES_API_KEY=

# Preferred over the anon key — server-only; lets RLS be enabled with no policies.
SUPABASE_SERVICE_ROLE_KEY=

# Live outbound calls (off by default; requires a Twilio number imported into ElevenLabs)
LIVE_CALLS_ENABLED=
ELEVENLABS_PHONE_NUMBER_ID=
NEXT_PUBLIC_LIVE_CALLS=
